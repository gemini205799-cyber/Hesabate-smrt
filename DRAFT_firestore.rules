rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Helpers ---

    function isValidExpense(data) {
      return data.amount is number && 
             data.category is string && data.category.size() <= 100 &&
             data.date is string &&
             data.currency in ['IQD', 'USD'] &&
             data.type in ['fixed', 'variable'] &&
             data.status in ['paid', 'partially_paid', 'unpaid'] &&
             data.userId == request.auth.uid;
    }

    function isValidSula(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.totalAmount is number &&
             data.monthlyInstallment is number &&
             data.status in ['active', 'completed'] &&
             data.userId == request.auth.uid;
    }

    function isValidDebt(data) {
      return data.type in ['owe', 'owed'] &&
             data.personName is string && data.personName.size() <= 100 &&
             data.amount is number &&
             data.remainingAmount is number &&
             data.userId == request.auth.uid;
    }

    function isValidSetting(data) {
      return data.id is string && data.id.size() <= 100 &&
             data.userId == request.auth.uid;
    }

    // --- Collection Routes ---

    match /users/{userId} {
      allow read: if isOwner(userId);
      
      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidExpense(incoming()) && isValidId(expenseId);
        allow update: if isOwner(userId) && isValidExpense(incoming()) && isValidId(expenseId);
        allow delete: if isOwner(userId);
      }

      match /sulas/{sulaId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSula(incoming()) && isValidId(sulaId);
        allow update: if isOwner(userId) && isValidSula(incoming()) && isValidId(sulaId);
        allow delete: if isOwner(userId);
      }

      match /debts/{debtId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDebt(incoming()) && isValidId(debtId);
        allow update: if isOwner(userId) && isValidDebt(incoming()) && isValidId(debtId);
        allow delete: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSetting(incoming()) && isValidId(settingId);
        allow update: if isOwner(userId) && isValidSetting(incoming()) && isValidId(settingId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
